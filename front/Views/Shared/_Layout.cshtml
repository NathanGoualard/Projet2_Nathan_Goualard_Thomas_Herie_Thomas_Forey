<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Bibliothèque</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>

<body>

@{
    var role = Context.Session.GetString("Role");
}

<header class="navbar">
    <div class="navbar-left">
        <span class="logo">📚</span>

        <a asp-controller="Home" asp-action="Index">Accueil</a>
        <a asp-controller="Catalogue" asp-action="Index">Catalogue</a>
        <a asp-controller="Emprunts" asp-action="MesEmprunts">Mes emprunts</a>


        @* Liens visibles uniquement pour le bibliothécaire *@
        @if (role == "Bibliothécaire")
        {
            <a asp-controller="Livres" asp-action="Index">Gestion des livres</a>
            <a asp-controller="Emprunts" asp-action="Index">Emprunts et retours</a>
        }
    </div>

    <div class="navbar-right">
        <form method="get" asp-controller="Catalogue" asp-action="Index">
    <input type="text" name="search" placeholder="Rechercher un livre..." />
    <button type="submit">🔍</button>
</form>
    </div>
</header>

<main>
    @RenderBody()
</main>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const slides = document.querySelectorAll(".promo-slide");
        let current = 0;

        if (slides.length > 0) {
            setInterval(() => {
                slides[current].classList.remove("active");
                current = (current + 1) % slides.length;
                slides[current].classList.add("active");
            }, 5000);
        }
    });
</script>

</body>
</html>