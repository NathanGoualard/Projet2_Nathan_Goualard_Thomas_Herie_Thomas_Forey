@model List<front.Models.Livre>

@{
    ViewData["Title"] = "Accueil";
}

@if (ViewBag.Error != null)
{
    <p style="color:red">@ViewBag.Error</p>
}

<section class="promo-carousel">
    <img src="~/images/car1.png" class="promo-slide active" alt="Promotion 1" />
    <img src="~/images/car2.png" class="promo-slide" alt="Promotion 2" />
    <img src="~/images/car3.png" class="promo-slide" alt="Promotion 3" />
</section>



<section class="new-releases">
    <h3>NOUVELLES SORTIES</h3>

    <div class="books-container">
        @foreach (var livre in Model)
        {
            <div class="book-card">
                <img src="~/images/book.png" alt="Couverture du livre" class="book-image" />

                <p class="book-title">
                    <strong>@livre.Nom</strong>
                </p>

                <p class="book-author">
                    @livre.Auteur.Prenom @livre.Auteur.Nom
                </p>

                <p class="book-genre">
                    Genre : @livre.Genre.Nom
                </p>

                <p class="book-year">
                    Année : @livre.Annee.Year
                </p>
            </div>
        }
    </div>
</section>
